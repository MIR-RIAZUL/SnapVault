# ============================================================
# SnapVault .gitignore
# Covers: Node.js, Rust/Cargo, Tauri, SQLite, IDE, OS files
# ============================================================

# ---- Node.js / npm ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak
.npm
.eslintcache

# ---- Vite / Frontend Build ----
dist/
dist-ssr/
*.local
.vite/

# ---- Rust / Cargo ----
target/
**/*.rs.bk
Cargo.lock
# Note: Cargo.lock IS committed for binary projects (Tauri app).
# Remove the Cargo.lock line above after Phase 1 scaffold.
!src-tauri/Cargo.lock

# ---- Tauri ----
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.nsis
*.exe
!src-tauri/icons/

# ---- SQLite ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ---- SnapVault Test / Dev Data ----
.snapvault/
snapvault-test-data/
test-chunks/
test-restore/

# ---- IDE & Editor ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---- OS Files ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Environment & Secrets ----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- Coverage & Reports ----
coverage/
*.lcov
htmlcov/
.nyc_output/

# ---- Misc ----
*.log
*.tmp
*.bak
*.orig
